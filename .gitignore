# Vendored weights, checkpoints, and compile cache
deploy/deps/

# Python
.venv/
.toolchain/
tulip/models/
tulip/cache/
tulip/evidence/
__pycache__/
*.py[cod]
*.egg-info/

# Runtime artifacts
deploy/recordings/

# joyomni_ops build artifacts (compiled locally via pip install)
deploy/joyomni_ops/build/
deploy/joyomni_ops/**/*.so
deploy/joyomni_ops/**/*.pyd
tulip/*.log

# Third-party build checkouts (SageAttention, cutlass -> deploy/tmp/, see DEPLOYMENT.md §2)
deploy/tmp/

# Hugging Face Space checkout (never commit to the public repo)
deploy/hf_space/

# Read-only pinned SR research source; see tulip/UPSCALING_TRIAL.md.
tulip/research/Real-ESRGAN/

# Machine-local launch preferences, read on each SDK/supervisor restart.
tulip/runtime-settings.json
tulip/performance-settings.json
tulip/vfx-runtime.json

# Isolated vendor VFX package used for local benchmarks.
tulip/research/vfx-probe/
tulip/research/vfx-0.2.0.0/

# Local restore points include private prompts and machine settings.
tulip/favorites/

# Vendored third-party research packages and nested checkouts (large, own repos/licenses).
tulip/research/visual-enhancer-v11/
tulip/research/dlssg-python/
tulip/research/video2dlssnr/

# Local source restore snapshots and atomic-write/backup leftovers.
tulip/*-backup-*/
tulip/resident-restore-*/
tulip/*.tmp
tulip/*.bak

# Encoded video test captures (large binaries; evidence lives outside git).
tulip/*.flv
tulip/*.h264
tulip/*.mp4

# Recorded replay inputs (large video).
tulip/drift_lab/inputs/
